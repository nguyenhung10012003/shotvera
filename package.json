{
  "name": "shotvera",
  "private": true,
  "version": "0.3.0",
  "description": "Capture, annotate, and ask AI about anything on your screen. A cross-platform screenshot tool with a built-in Claude assistant.",
  "license": "Apache-2.0",
  "keywords": [
    "screenshot",
    "screen-capture",
    "screenshot-tool",
    "annotation",
    "image-annotation",
    "ocr",
    "ai",
    "claude",
    "anthropic",
    "tauri",
    "rust",
    "react",
    "typescript",
    "desktop-app",
    "cross-platform",
    "macos",
    "windows",
    "linux",
    "productivity"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:mac": "tauri build --bundles app,dmg",
    "build:mac:intel": "tauri build --target x86_64-apple-darwin --bundles app,dmg",
    "build:mac:universal": "tauri build --target universal-apple-darwin --bundles app,dmg",
    "build:win": "tauri build --bundles nsis,msi",
    "build:linux": "tauri build --bundles appimage,deb,rpm",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-global-shortcut": "^2.4.1",
    "@tauri-apps/plugin-notification": "^2.8.1",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-store": "^2.5.1",
    "konva": "^10.9.1",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-konva": "^19.3.2",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
